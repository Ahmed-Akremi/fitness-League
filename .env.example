# Copy to apps/api/.env for local runs (the API and the Prisma CLI both read it).
# Never commit real values. Production secrets come from the platform secret manager (docs/ARCHITECTURE.md §9.5).

NODE_ENV=development
PORT=3000
APP_NAME=Fitness League
LOG_LEVEL=info

# PostgreSQL 16. Docker: postgresql://fl:fl@localhost:5432/fitness_league
# Docker-free: `pnpm --filter @fitness-league/api db:embedded` then postgresql://fl:fl@localhost:55432/fitness_league
DATABASE_URL=postgresql://fl:fl@localhost:5432/fitness_league?schema=public
REDIS_URL=redis://localhost:6379

# >= 32 random chars: `openssl rand -base64 48`
CURSOR_HMAC_SECRET=change-me-change-me-change-me-change-me

# Comma-separated origins allowed by CORS (admin panel). Mobile apps need none.
CORS_ORIGINS=http://localhost:5173

# Business timezone offset in minutes (Africa/Tunis = UTC+1, no DST).
BUSINESS_UTC_OFFSET_MINUTES=60

# Serve Swagger UI at /api/docs (keep false in production).
OPENAPI_ENABLED=true

# JWT signing keys (Ed25519). Generate: `pnpm --filter @fitness-league/api keys:generate`
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
JWT_KEY_ID=k1
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_DAYS=30

# Email. Local: mailpit (smtp://localhost:1025, UI on :8025). Empty = emails are only logged.
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Fitness League <no-reply@fitnessleague.app>
APP_LINK_BASE_URL=https://app.fitnessleague.app

# Health data (body weight, measurements) is encrypted with AES-256-GCM. keyId:base64(32 bytes), newest first.
# Generate: echo "k1:$(openssl rand -base64 32)"
HEALTH_DATA_KEYS=

# OAuth client ids (comma-separated). Empty disables the provider.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# DEV ONLY: fixed admin 2FA code (skips authenticator enrolment). The API refuses to start with it in production.
# DEV_STATIC_TOTP_CODE=000000
