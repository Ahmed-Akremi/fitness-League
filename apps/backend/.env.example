# Copy to .env (git-ignored). Values are local development defaults matching infra/docker-compose.yml.
APP_ENV=development
PORT=3100
LOG_LEVEL=info

# The API and the worker connect with the least-privileged account; only `backend migrate` uses fl_migrate.
DATABASE_URL=mysql://fl_app:fl_app_dev@127.0.0.1:3307/fitness_league
MIGRATE_DATABASE_URL=mysql://fl_migrate:fl_migrate_dev@127.0.0.1:3307/fitness_league
REDIS_URL=redis://:fl_redis_dev@127.0.0.1:6379

CORS_ORIGINS=http://localhost:5173,http://localhost:8081
TRUSTED_PROXIES=
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=Fitness League <no-reply@fitnessleague.app>
# The base of the links sent by email.
APP_LINK_BASE_URL=http://localhost:8081

# Generate these three, never commit them:
#   cargo run -q -- keys >> .env
#   printf 'APP_HMAC_SECRET=%s\n' "$(openssl rand -base64 48)" >> .env
# JWT_PRIVATE_KEY_B64=
# JWT_PUBLIC_KEY_B64=
# APP_HMAC_SECRET=
