// Fitness League — Phase 1 schema. See docs/ARCHITECTURE.md §3.
// Things Prisma cannot express (partial unique indexes, CHECK constraints, ledger immutability triggers)
// live in the raw SQL part of the migrations and are listed at the bottom of this file.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, pgcrypto]
}

